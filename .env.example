# GeoKader Environment Variables
# Offline-first participatory mapping applet

# --- Sumber tile peta ---------------------------------------------------------
# Tiga layanan publik bawaan (Esri World Imagery, OpenStreetMap, OpenTopoMap) hanya untuk
# DILIHAT online. Unduhan peta offline TIDAK aktif untuk layanan tersebut karena tidak
# semuanya mengizinkan pengunduhan massal (kebijakan OSM melarangnya).
#
# Untuk mengaktifkan unduhan offline, pasang penyedia tile yang lisensinya mengizinkan
# (server tile sendiri, atau penyedia berlangganan) lalu nyatakan izinnya:
#   VITE_TILE_URL_<SUMBER>   = templat URL dengan {z}, {x}, {y}
#   VITE_TILE_UNDUH_<SUMBER> = true
# <SUMBER> adalah SATELIT, OSM, atau TOPO. Penyedia harus mengirim header CORS.
# Setelah mengubah nilai ini, bangun ulang aplikasi (npm run build).
#
# VITE_TILE_URL_SATELIT=https://tiles.contoh.id/satelit/{z}/{x}/{y}.jpg
# VITE_TILE_UNDUH_SATELIT=true
