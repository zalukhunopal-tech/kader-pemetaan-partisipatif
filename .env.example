# GeoKader Environment Variables
# Offline-first participatory mapping applet

# --- Sumber tile peta ---------------------------------------------------------
# Bawaan (gratis, dengan atribusi otomatis di peta, HANYA untuk dilihat online):
#   Satelit  : Sentinel-2 cloudless 2016 oleh EOX (CC BY 4.0, resolusi 10 m)
#   OSM      : tile.openstreetmap.org (data ODbL, kebijakan tile OSMF)
#   Topografi: OpenTopoMap (CC-BY-SA)
# Unduhan peta offline TIDAK aktif untuk layanan tersebut karena ketentuannya tidak mengizinkan
# pengunduhan massal.
#
# Satelit resolusi tinggi Esri (opsional): buat akun ArcGIS Location Platform, buat kunci API dengan
# hak "Basemaps", dan batasi kunci ke domain aplikasi Anda (kunci ikut terlihat di aplikasi).
# Gratis sampai kuota bulanan akun; tetap tidak boleh diunduh untuk offline.
# VITE_ESRI_API_KEY=kunci-api-arcgis
#
# Untuk peta offline, pasang penyedia tile yang lisensinya mengizinkan (mis. tile buatan sendiri
# dari Sentinel-2 Copernicus atau data OpenStreetMap, disajikan dari server organisasi):
#   VITE_TILE_URL_<SUMBER>      = templat URL dengan {z}, {x}, {y}
#   VITE_TILE_UNDUH_<SUMBER>    = true
#   VITE_TILE_ATRIBUSI_<SUMBER> = teks atribusi yang wajib tampil di peta
#   VITE_TILE_ZOOM_MAKS_SATELIT = zoom tertinggi tile satelit Anda (bawaan 19)
# <SUMBER> adalah SATELIT, OSM, atau TOPO. Penyedia harus mengirim header CORS.
# Setelah mengubah nilai ini, bangun ulang aplikasi (npm run build).
#
# VITE_TILE_URL_SATELIT=https://tiles.contoh.id/satelit/{z}/{x}/{y}.jpg
# VITE_TILE_UNDUH_SATELIT=true
# VITE_TILE_ATRIBUSI_SATELIT=Berisi data Copernicus Sentinel 2026 yang dimodifikasi

# --- Sertifikat dan akun -----------------------------------------------------
# Tautan verifikasi yang dikodekan di QR sertifikat (menerima parameter ?no=...&id=...).
# Tanpa ini, QR berisi teks bertanda "GEOKADER|nomor|ID kader|tanggal".
# VITE_URL_VERIFIKASI=https://sertifikat.contoh.id/verifikasi
#
# Kode aktivasi untuk membuat Administrator pertama di perangkat baru (penyiapan awal). Pencegah salah pakai,
# BUKAN rahasia: nilai VITE_* ikut tertanam di aplikasi yang dikirim ke peramban.
# VITE_KODE_ADMIN=kode-organisasi

