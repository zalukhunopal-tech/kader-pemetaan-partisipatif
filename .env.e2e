# Hanya untuk uji browser (npm run test:e2e): kunci API PALSU agar pilihan Satelit Google dan Esri
# muncul di bundel dist-e2e. Jaringan Google/Esri ditiru di tes; kunci ini tidak berlaku di mana pun.
VITE_GOOGLE_MAPS_API_KEY=kunci-uji-google-123456
VITE_ESRI_API_KEY=kunci-uji-esri
VITE_TILE_URL_OSM=https://tile.uji.example/{z}/{x}/{y}.png
VITE_TILE_UNDUH_OSM=true
VITE_TILE_ATRIBUSI_OSM=© Kontributor OpenStreetMap (penyedia tile uji)
